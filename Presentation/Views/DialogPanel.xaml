<UserControl x:Class="MessengerDesktop.Presentation.Views.DialogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MessengerDesktop.Presentation.Views"
             xmlns:vm="clr-namespace:MessengerDesktop.Presentation.ViewModels"
             xmlns:models="clr-namespace:MessengerDesktop.Core.Models"
             xmlns:controls="clr-namespace:MessengerDesktop.Presentation.Controls"
             xmlns:converter="clr-namespace:MessengerDesktop.Presentation.Views.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converter:MessageHorizontalAligmentConverter x:Key="MessageAligmentConverter"/>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource MainTextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SomePanelColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource HintTextColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <DockPanel LastChildFill="True" HorizontalAlignment="Stretch" Background="{StaticResource MainBackgroundColor}">
            <Border BorderThickness="0" 
                        DockPanel.Dock="Top" 
                        Height="70"
                        HorizontalAlignment="Stretch">
                <Label Foreground="{StaticResource MainTextColor}"
                           FontSize="16" 
                           Content="{Binding Name}"  
                           Height="50"
                           HorizontalAlignment="Left"
                           HorizontalContentAlignment="Left"/>
            </Border>
            <Grid Background="{StaticResource MainBackgroundColor}"                         
                      DockPanel.Dock="Bottom"
                      Height="70"
                      HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="16"
                            TextAlignment="Left" 
                            Foreground="Gray"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Text="Введите сообщение..." 
                            Height="20"
                            Visibility="{Binding ElementName=EnterBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVis}}" 
                            IsHitTestVisible="False" 
                            Margin="10,0,0,0"/>

                <TextBox Name="EnterBox"
                            FontSize="16"
                            TextAlignment="Left" 
                            Foreground="{StaticResource MainTextColor}"
                            Background="{StaticResource EmptyObjectColor}"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" 
                            Height="20"
                            AcceptsReturn="False" 
                            Margin="10,0,0,0">
                    <i:Interaction.Triggers>
                        <i:KeyTrigger Key="Return">
                            <i:InvokeCommandAction Command="{Binding SendCommand}"/>
                        </i:KeyTrigger>
                    </i:Interaction.Triggers>
                </TextBox>

                <Button Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource RoundedButton}"
                        Content="Send"
                        FontSize="12"
                        Height="40"
                        Width="50"
                        Command="{Binding SendCommand}" 
                        Padding="0,0,0,0">
                </Button>
            </Grid>
            <controls:ChatListView 
                      ScrollViewer.CanContentScroll="False"
                      ItemsSource="{Binding Messages}"            
                      FontSize="24" 
                      BorderThickness="0" 
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource SomePanelColor}" 
                      Foreground="{StaticResource MainTextColor}">
                <controls:ChatListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:MessageModel}">
                        <Border Background="{StaticResource MainBackgroundColor}"
                            HorizontalAlignment="Right"
                            CornerRadius="20"
                            MaxWidth="400"
                            Margin="10,10,10,10">

                            <TextBlock TextWrapping="Wrap"
                            Text="{Binding Message}" 
                            Margin="10,10,10,10"/>
                        </Border>
                    </DataTemplate>
                </controls:ChatListView.ItemTemplate>
                <controls:ChatListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </controls:ChatListView.ItemContainerStyle>
            </controls:ChatListView>
        </DockPanel>
    </Grid>
</UserControl>
