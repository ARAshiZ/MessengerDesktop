<UserControl x:Class="MessengerDesktop.Presentation.Views.MainPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MessengerDesktop.Presentation.Views"
             xmlns:vm="clr-namespace:MessengerDesktop.Presentation.ViewModels"
             xmlns:controls="clr-namespace:MessengerDesktop.Presentation.Controls"
             xmlns:models="clr-namespace:MessengerDesktop.Core.Models"
             xmlns:views="clr-namespace:MessengerDesktop.Presentation.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}"/>
    </UserControl.InputBindings>

    <Grid x:Name="MainListGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*" MinWidth="200" MaxWidth="700"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                Background="{StaticResource MainBackgroundColor}"/>

        <controls:ChatListView x:Name="DialogUserList" Grid.Column="1"
         Background="{StaticResource MainBackgroundColor}"
         BorderThickness="0"
         ItemsSource="{Binding UserList}"
         SelectedItem="{Binding SelectUserDialog}"
         Padding="0,0,0,0"
         HorizontalContentAlignment="Left"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <controls:ChatListView.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListView}}}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </controls:ChatListView.ItemContainerStyle>

            <controls:ChatListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ChatUserViewModel}">
                    <local:UserChatTemplate/>
                </DataTemplate>
            </controls:ChatListView.ItemTemplate>
        </controls:ChatListView>

        <GridSplitter Grid.Column="2"
              Width="4"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{StaticResource MainBackgroundColor}"
              ResizeDirection="Columns"
              ShowsPreview="False"/>

        <ContentControl Grid.Column="3"
                Content="{Binding DialogPanel}"
                VerticalContentAlignment="Stretch"
                HorizontalContentAlignment="Stretch"/>

    </Grid>
</UserControl>
