<Window x:Class="MessengerDesktop.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MessengerDesktop.Presentation.Views"
        xmlns:vm="clr-namespace:MessengerDesktop.Presentation.ViewModels"
        xmlns:controls="clr-namespace:MessengerDesktop.Presentation.Controls"
        xmlns:models="clr-namespace:MessengerDesktop.Core.Models"
        xmlns:views="clr-namespace:MessengerDesktop.Presentation.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Messenger" Height="800" Width="1300" MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <ContentControl
            Content="{Binding ViewPanel}"
            VerticalContentAlignment="Stretch"
            HorizontalContentAlignment="Stretch"/>




</Window>
