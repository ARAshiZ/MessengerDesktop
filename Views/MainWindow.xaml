<Window x:Class="MessengerDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MessengerDesktop.Views"
        xmlns:vm="clr-namespace:MessengerDesktop.ViewModels"
        xmlns:models="clr-namespace:MessengerDesktop.Models"
        xmlns:views="clr-namespace:MessengerDesktop.Views"
        mc:Ignorable="d"
        Title="Messenger" Height="800" Width="1200" MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <d:Window.DataContext>
        <vm:MainViewModel/>
    </d:Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChoiceDialogPlaceholder_VM}">
            <views:ChoiceDialogPlaceholder/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DialogPanel_VM}">
            <views:DialogPanel/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0"
             Background="{StaticResource MainBackgroundColor}"
             BorderThickness="0"
             ItemsSource="{Binding UserList}"
             SelectedItem="{Binding SelectUserDialog}"
             Padding="0,0,0,0"
             HorizontalContentAlignment="Left">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ChatUserModel}">
                    <local:UserChatTemplate/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Column="1"
                  Width="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{StaticResource MainBackgroundColor}"
                  ResizeDirection="Columns"
                  ShowsPreview="False"/>

        <ContentControl Grid.Column="2"
                    Content="{Binding DialogPanel}"
                    VerticalContentAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"/>
    </Grid>
</Window>
